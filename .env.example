# Copy this file to .env and fill in the real values.
# .env is gitignored. Never commit a real token.

# From @BotFather on Telegram: /newbot -> display name -> username ending in "bot".
# If this token is ever pasted anywhere it should not be, revoke it with /revoke.
TELEGRAM_BOT_TOKEN=123456789:AAduMMy-pLaCeHoLdEr-ToKeN-ReplaceMe

# Optional. DEBUG | INFO | WARNING | ERROR. Defaults to INFO.
LOG_LEVEL=INFO

# Model provider. Change only MODEL_PROVIDER to switch between local Ollama and
# Bedrock once the Bedrock quota is available. These are non-secret defaults.
MODEL_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
BEDROCK_REGION=us-west-2
BEDROCK_TEXT_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_VISION_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Deployment lifecycle only. Generate a separate 1–256-character Telegram
# webhook secret, store the same value in SSM, and never commit the real value.
PANTRYPULSE_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
